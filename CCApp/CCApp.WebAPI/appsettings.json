{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Mvc": "Warning"

      }
    },
    "WriteTo": [
        {
          "Name": "File",
          "Args": {
            "path": "./logs/log-.txt",
            "rollingInterval": "Day"
          }
        }
      ]
    },
  "AllowedHosts": "*"
}